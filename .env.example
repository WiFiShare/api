# Copy to .env and fill in. Never commit the result: .env is in .gitignore.
# Every value here is a placeholder. Nothing in this file is a real secret.

# --- Required in a deployment ---------------------------------------------

# Django's signing key. Generate one with:
#   env -u PYTHONPATH uv run --python 3.12 python -c \
#     "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-to-a-random-50-character-string

# Comma-separated. No wildcard.
ALLOWED_HOSTS=api.wifishare.example

# Server-held pepper for the opt-out HMACs (P5). Generate 32 random bytes:
#   env -u PYTHONPATH uv run --python 3.12 python -c \
#     "import secrets; print(secrets.token_urlsafe(32))"
# Changing it makes every existing opt-out stop matching, so treat it as
# permanent and back it up with the database.
OPTOUT_PEPPER=change-me-to-a-random-32-byte-value

# --- Optional -------------------------------------------------------------

# Leave unset for the local SQLite file. docker-compose sets the Postgres form.
# DATABASE_URL=postgres://wifishare:change-me@db:5432/wifishare
DATABASE_URL=sqlite:///wifishare.sqlite3

# Never turn this on in a deployment.
DEBUG=off

# Set when a proxy you control terminates TLS in front of the service.
BEHIND_TLS_PROXY=off
# Only with a proxy you control: otherwise a caller can choose their own bucket.
TRUST_X_FORWARDED_FOR=off
# CSRF_TRUSTED_ORIGINS=https://api.wifishare.example

# Requests per hour, per rate-limit bucket.
RATE_LIMIT_BATCHES=60
RATE_LIMIT_REPORTS=30
RATE_LIMIT_OPTOUT=10
RATE_LIMIT_CLAIMS=10

# How long a rotated ingest key keeps decrypting envelopes already in flight.
KEY_GRACE_DAYS=30

# Cache-Control max-age on GET /v1/areas/{gh5}.
AREA_CACHE_SECONDS=3600

LOG_LEVEL=INFO

# Where the spec repo is checked out. Only the tests read it.
# WIFISHARE_SPEC_DIR=../spec
