{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wifishare.github.io/spec/schemas/network.schema.json",
  "title": "PublishedNetwork",
  "description": "A network as published through the API and the dump. Community-found networks never carry a BSSID (P2); owner-verified ones may carry BSSIDs, a venue and a credential (P3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "ssid", "security", "verification", "lat", "lon", "precision_m", "cell", "first_seen", "last_seen", "reports"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z2-7]{12}$",
      "description": "Random base32 id, with no derivation from BSSID, SSID or position (P8)."
    },
    "ssid": { "type": "string", "minLength": 1, "maxLength": 32 },
    "security": {
      "enum": ["open", "owe", "shared"],
      "description": "shared means the owner published a credential for an encrypted network."
    },
    "captive_portal": { "enum": ["unknown", "detected", "none"], "default": "unknown" },
    "verification": { "enum": ["community", "owner-verified"] },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "precision_m": {
      "enum": [10, 150],
      "description": "150 for a community-found network, whose position is the centre of its geohash-7 cell. 10 for an owner-verified one."
    },
    "cell": { "type": "string", "pattern": "^[0-9b-hjkmnp-z]{7}$" },
    "first_seen": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "last_seen": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["works", "fails"],
      "properties": {
        "works": { "type": "integer", "minimum": 0 },
        "fails": { "type": "integer", "minimum": 0 }
      }
    },
    "bssids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$" },
      "description": "Owner-verified networks only."
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "kind": { "type": "string", "maxLength": 40 }
      },
      "description": "Owner-verified networks only."
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["wpa2-psk", "wpa3-psk", "portal", "none"] },
        "secret": { "type": "string", "maxLength": 128 },
        "note": { "type": "string", "maxLength": 200 }
      },
      "description": "Owner-verified networks only, and only when the owner chose to publish it."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verification": { "const": "community" } }, "required": ["verification"] },
      "then": {
        "properties": { "precision_m": { "const": 150 } },
        "not": { "anyOf": [{ "required": ["bssids"] }, { "required": ["credential"] }, { "required": ["venue"] }] }
      }
    }
  ]
}
