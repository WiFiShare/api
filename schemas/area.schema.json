{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wifishare.github.io/spec/schemas/area.schema.json",
  "title": "Area file",
  "description": "All published networks in one geohash-5 cell, as a GeoJSON FeatureCollection with foreign members naming the cell and the license. GET /v1/areas/{geohash5} returns this same document, so clients need one parser for the API and the dump.",
  "type": "object",
  "required": ["type", "schema", "cell", "generated", "license", "attribution", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "schema": { "const": "wifishare.area/1" },
    "cell": { "type": "string", "pattern": "^[0-9b-hjkmnp-z]{5}$" },
    "generated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "license": { "const": "ODbL-1.0" },
    "attribution": { "const": "WiFiShare contributors" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "Feature" },
          "id": { "type": "string", "pattern": "^[a-z2-7]{12}$" },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "const": "Point" },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number" },
                "description": "[longitude, latitude], per RFC 7946."
              }
            }
          },
          "properties": { "$ref": "network.schema.json" }
        }
      }
    }
  }
}
