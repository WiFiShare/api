{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wifishare.github.io/spec/schemas/batch.schema.json",
  "title": "Batch",
  "description": "The plaintext inside an envelope. Carries no identifier, sequence number or timestamp of its own, so that two batches from one device cannot be linked (R12).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "client", "observations"],
  "properties": {
    "schema": { "const": "wifishare.batch/1" },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "version"],
      "properties": {
        "platform": { "enum": ["android", "ios", "other"] },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}$",
          "description": "Major.minor only. Patch level and build are deliberately not reported."
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "observation.schema.json" }
    }
  }
}
